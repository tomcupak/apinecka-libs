{
	"name": "@apinecka/amqp",
	"version": "1.0.0",
	"description": "NestJS module for AMQP/RabbitMQ: declarative exchange/queue/binding schemas, decorator-based consumers, batch consumers, and publish helpers on top of amqp-connection-manager.",
	"keywords": [
		"nestjs",
		"amqp",
		"rabbitmq",
		"amqp-connection-manager"
	],
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"clean": "del-cli dist",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"author": "Tomáš Cupák <tomcupak@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/tomcupak/apinecka-libs.git",
		"directory": "libs/amqp"
	},
	"homepage": "https://github.com/tomcupak/apinecka-libs/tree/main/libs/amqp#readme",
	"bugs": {
		"url": "https://github.com/tomcupak/apinecka-libs/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@nestjs/common": "^11.0.0",
		"@nestjs/core": "^11.0.0",
		"amqp-connection-manager": "^4.1",
		"amqplib": "*"
	},
	"devDependencies": {
		"@nestjs/common": "^11.1.7",
		"@nestjs/core": "^11.1.7",
		"amqp-connection-manager": "^4.1.15",
		"amqplib": "^2.0.1",
		"del-cli": "^7.0.0",
		"typescript": "^5.8.3",
		"@types/node": "^22.15.33"
	}
}
